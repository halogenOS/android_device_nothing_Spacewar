type glyph_app, domain;
typeattribute glyph_app mlstrustedsubject;

app_domain(glyph_app)

allow glyph_app {
  app_api_service
  audioserver_service
  mediaserver_service
}:service_manager find;

allow glyph_app system_app_data_file:dir create_dir_perms;
allow glyph_app system_app_data_file:{
  file
  lnk_file
} create_file_perms;

allow glyph_app sysfs_leds:dir search;

allow glyph_app vendor_sysfs_battery_supply:dir search;
allow glyph_app vendor_sysfs_battery_supply:file { read open getattr };
allow glyph_app sysfs_powershare:file rw_file_perms;

rw_dir_file(glyph_app, vendor_sysfs_glyph)
