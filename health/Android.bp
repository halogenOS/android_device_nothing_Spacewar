cc_binary {
    name: "vendor.lineage.health-service.spacewar",
    vendor: true,
    relative_install_path: "hw",
    init_rc: ["vendor.lineage.health-service.spacewar.rc"],
    vintf_fragments: ["vendor.lineage.health-service.spacewar.xml"],
    srcs: [
        "service.cpp",
        "ChargingControl.cpp",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "vendor.lineage.health-V2-ndk",
    ],
}
