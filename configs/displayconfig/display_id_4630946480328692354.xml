            </brightnessPoint>
            <brightnessPoint>
                <nits>1018.0</nits>
                <backlight>1.0</backlight>
                <brightness>1.0</brightness>
            </brightnessPoint>
        </brightnessMapping>
        <luxToMinimumNitsMap>
            <point>
                <value>0.0</value>
                <nits>0.2</nits>
            </point>
            <point>
                <value>10.0</value>
