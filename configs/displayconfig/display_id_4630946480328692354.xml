        </point>
        <point>
            <value>1.0</value>
            <nits>1018.0</nits>
        </point>
    </screenBrightnessMap>
    <highBrightnessMode enabled="true">
        <transitionPoint>0.858364</transitionPoint>
        <minimumLux>7000.0</minimumLux>
        <timing>
            <!-- Time limitation for HBM-->
            <timeWindowSecs>0</timeWindowSecs>
            <timeMaxSecs>0</timeMaxSecs>
            <timeMinSecs>0</timeMinSecs>
        </timing>
        <!-- Thermal limitation for HBM -->
        <thermalStatusLimit>critical</thermalStatusLimit>
        <minimumHdrPercentOfScreen>0.4</minimumHdrPercentOfScreen>
        <!--sdrHdrRatioMap, backed by spline, must have at least two entries -->
        <sdrHdrRatioMap>
            <point>
                <sdrNits>2.0</sdrNits>
                <hdrRatio>4.5</hdrRatio>
            </point>
            <point>
                <sdrNits>100.0</sdrNits>
                <hdrRatio>4.0</hdrRatio>
            </point>
            <point>
                <sdrNits>200.0</sdrNits>
                <hdrRatio>2.2</hdrRatio>
            </point>
            <point>
                <sdrNits>300.0</sdrNits>
                <hdrRatio>1.8</hdrRatio>
            </point>
            <point>
                <sdrNits>400.0</sdrNits>
                <hdrRatio>1.5</hdrRatio>
            </point>
            <point>
                <sdrNits>480.0</sdrNits>
                <hdrRatio>1.4</hdrRatio>
            </point>
        </sdrHdrRatioMap>
    </highBrightnessMode>
    <!-- The panel DBV scale is gamma 2.2 encoded (the screenBrightnessMap above is the
         measured backlight -> nits curve), while the framework brightness slider assumes a
         backlight value proportional to luminance. With gamma applied twice the lower half of
         the slider collapsed into the 2-4 nit range and produced no visible brightness change.
         Remap the framework brightness scale to be linear in nits (brightness = nits / 1018,
         the panel peak) so the slider gamma curve lands on actual luminance.

         The extended-dim range is kept live so Extra Dim works: transitionPoint is the panel
         hardware floor (2.0 nits); below it the backlight sits at its minimum and the reduce
         bright colors matrix takes over, down to the sub-floor mapping point (0.2 nits at
         backlight 0). luxToMinimumNitsMap sets how far Extra Dim may dim per ambient lux
         (lower in the dark, back up to the 2.0 nit floor in bright rooms). backlight/nits at
         and above 2.0 are the measured panel curve. -->
    <evenDimmer enabled="true">
        <transitionPoint>0.0019646</transitionPoint>
        <brightnessMapping>
            <brightnessPoint>
                <nits>0.2</nits>
                <backlight>0.0</backlight>
                <brightness>0.0</brightness>
            </brightnessPoint>
            <brightnessPoint>
                <nits>2.0</nits>
                <backlight>0.04</backlight>
